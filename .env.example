# FutureFork backend configuration (copy to .env; loaded automatically on startup)

# --- Application ---
# "production" hides exception details in API error responses
ENVIRONMENT=development
PORT=8000
# Comma-separated frontend origins allowed by CORS ("*" allows any origin, without credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database: SQLite locally, or a Postgres connection string (e.g. Supabase) ---
DATABASE_URL=sqlite:///./futurefork.db

# --- AI layer (optional) ---
# Without a key, every agent uses its deterministic regex/template fallback.
OPENAI_API_KEY=
# GROQ_API_KEY=
# Set to 1 to force offline mode even when a key is set
# FUTUREFORK_OFFLINE=1

# --- Engine ---
NUM_SIMULATION_RUNS=300
RANDOM_SEED=42
CACHE_ENABLED=true
